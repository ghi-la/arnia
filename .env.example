# Copy this file to .env and fill in real values.
# Generate strong secrets (POSTGRES_PASSWORD, BETTER_AUTH_SECRET, APP_ENCRYPTION_KEY,
# DATABASE_URL) with: ./scripts/generate-secrets.sh

# ---------------------------------------------------------------------------
# Domain & runtime
# ---------------------------------------------------------------------------

# Public domain Caddy will request a TLS certificate for, e.g. arnia.example.org
# Not used for local development (see docker-compose.dev.yml / README "local testing").
APP_DOMAIN=

# Port the SvelteKit Node server listens on inside its container.
PORT=3000

# Log level for the structured (pino) logger: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------

POSTGRES_DB=arnia
POSTGRES_USER=arnia
POSTGRES_PASSWORD=

# Full connection string used by the app/worker containers.
# With docker-compose, the host is the `db` service name.
DATABASE_URL=postgres://arnia:changeme@db:5432/arnia

# ---------------------------------------------------------------------------
# Secrets (generate with scripts/generate-secrets.sh, keep out of version control)
# ---------------------------------------------------------------------------

# Used by Better Auth to sign/encrypt session cookies and tokens.
BETTER_AUTH_SECRET=

# Base URL Better Auth uses for callback links (usually https://$APP_DOMAIN).
BETTER_AUTH_URL=

# 32-byte (base64) key used to encrypt secrets at rest (IMAP/SMTP passwords, etc.).
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------

# Max upload size in megabytes for attachments/photos.
MAX_UPLOAD_MB=25

# ---------------------------------------------------------------------------
# Email (transactional: invitations, verification, password reset, notifications)
# ---------------------------------------------------------------------------

# resend | smtp | none
#   resend: set RESEND_API_KEY and EMAIL_FROM (needs a verified sending domain — see README)
#   smtp:   set the SMTP_* variables below (e.g. your own server, or Mailpit in dev)
#   none:   nothing is sent; the admin copies invite/reset links from the UI instead
EMAIL_PROVIDER=none

RESEND_API_KEY=
EMAIL_FROM="Arnia <notifications@example.org>"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Email inbox (optional; IMAP polling + rule engine, see docs/PLAN.md phase 8)
# ---------------------------------------------------------------------------

MAIL_INGESTION_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
# How often to poll the mailbox, in minutes.
IMAP_POLL_INTERVAL_MINUTES=5

# ---------------------------------------------------------------------------
# Backups (see the `backup` service in docker-compose.yml)
# ---------------------------------------------------------------------------

BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# ---------------------------------------------------------------------------
# Web Push (optional, disabled by default — see docs/PLAN.md phase 11)
# ---------------------------------------------------------------------------

PUSH_ENABLED=false
