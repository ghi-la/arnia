# Copy this file to .env for local development (`pnpm dev`), and set the same
# variables in Vercel → Project → Settings → Environment Variables for deploys.
# See docs/deploy-vercel.md.

# ---------------------------------------------------------------------------
# Database: MongoDB Atlas
# ---------------------------------------------------------------------------

# Atlas → your cluster → Connect → Drivers. Replace <db_username>/<db_password>
# with a database user (Atlas → Database Access). URL-encode special characters
# in the password (e.g. @ → %40).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster-ghila.zrsoj.mongodb.net/
MONGODB_DB=arnia_dev

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------

# Signs/encrypts session cookies and tokens. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The app's public URL — callback and email links are built from it.
#   local: http://localhost:5173
#   Vercel: https://<your-project>.vercel.app (or your custom domain)
BETTER_AUTH_URL=http://localhost:5173

# 32-byte (base64) key for encrypting secrets at rest. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# File storage: Cloudflare R2 (item photos) — see docs/storage-r2.md
# ---------------------------------------------------------------------------

# R2 dashboard → Overview → Account details → Account ID
R2_ACCOUNT_ID=
# R2 → API Tokens → Create API token ("Object Read & Write", scoped to your bucket).
# Use the S3 "Access Key ID" / "Secret Access Key" — NOT the "Token value".
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Leave empty unless the bucket was created with a jurisdiction: then `eu` (or `fedramp`).
R2_JURISDICTION=

# Largest single photo upload in MB. Capped at 4 (Vercel rejects request bodies
# over 4.5 MB); photos are compressed in the browser to well under 1 MB anyway.
MAX_UPLOAD_MB=4

# ---------------------------------------------------------------------------
# Email (invitations, password resets)
# ---------------------------------------------------------------------------

# resend | smtp | none
#   resend: set RESEND_API_KEY and EMAIL_FROM (needs a verified sending domain)
#   smtp:   set the SMTP_* variables below
#   none:   nothing is sent; admins copy invite/reset links from the UI instead
EMAIL_PROVIDER=none

RESEND_API_KEY=
EMAIL_FROM="Arnia <notifications@example.org>"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Log level for the structured (pino) logger: fatal|error|warn|info|debug|trace
LOG_LEVEL=info
