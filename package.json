{
	"name": "arnia",
	"version": "0.1.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "pnpm@12.4.2",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"worker": "tsx src/worker.ts",
		"worker:dev": "tsx watch src/worker.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test",
		"test": "pnpm test:unit && pnpm test:e2e",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/lib/server/db/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx src/lib/server/db/seed.ts",
		"icons:generate": "node scripts/generate-icons.mjs",
		"prepare": "svelte-kit sync || true"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "22.20.3",
		"@types/nodemailer": "8.0.2",
		"@types/pdfkit": "0.17.6",
		"@vite-pwa/assets-generator": "1.0.4",
		"@vite-pwa/sveltekit": "1.1.0",
		"drizzle-kit": "0.31.10",
		"eslint": "10.10.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.12.0",
		"prettier": "3.9.7",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.0",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0",
		"vite": "8.3.0",
		"vitest": "5.0.1"
	},
	"dependencies": {
		"@fontsource/inter": "5.3.0",
		"@inlang/paraglide-js": "2.25.4",
		"@zxing/browser": "0.2.1",
		"better-auth": "1.7.5",
		"bits-ui": "2.19.2",
		"clsx": "2.1.1",
		"drizzle-orm": "0.45.2",
		"formsnap": "2.0.1",
		"@lucide/svelte": "1.47.0",
		"imapflow": "2.0.5",
		"mailparser": "3.9.28",
		"mode-watcher": "1.1.0",
		"nodemailer": "10.0.10",
		"pdfkit": "0.20.2",
		"pg-boss": "12.33.0",
		"pino": "10.3.1",
		"postgres": "3.4.9",
		"resend": "6.28.1",
		"sharp": "0.35.4",
		"sveltekit-superforms": "2.30.2",
		"swissqrbill": "4.4.1",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"tsx": "4.23.13",
		"tw-animate-css": "1.4.0",
		"web-push": "3.6.7",
		"zod": "4.6.5"
	}
}
