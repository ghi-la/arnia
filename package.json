{
	"name": "arnia",
	"version": "0.1.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "pnpm@12.4.2",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test": "pnpm test:unit",
		"db:seed": "tsx --env-file=.env src/lib/server/db/seed.ts",
		"storage:check": "tsx --env-file=.env src/lib/server/storage/check.ts",
		"icons:generate": "node scripts/generate-icons.mjs",
		"prepare": "svelte-kit sync || true"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-vercel": "7.0.5",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "26.6.6",
		"@types/nodemailer": "8.0.2",
		"@types/pdfkit": "0.17.7",
		"@types/qrcode": "1.5.6",
		"@vite-pwa/assets-generator": "2.0.0",
		"@vite-pwa/sveltekit": "2.0.3",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.2.0",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.58.0",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"typescript-eslint": "8.73.0",
		"vite": "8.3.8",
		"vitest": "5.1.1"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1169.0",
		"@fontsource/inter": "5.3.0",
		"@inlang/paraglide-js": "2.25.4",
		"@lucide/svelte": "1.47.0",
		"@zxing/browser": "0.2.1",
		"better-auth": "1.7.5",
		"bits-ui": "2.19.2",
		"clsx": "2.1.1",
		"formsnap": "2.0.1",
		"imapflow": "2.0.5",
		"mailparser": "3.9.28",
		"mode-watcher": "1.1.0",
		"mongodb": "7.9.0",
		"nodemailer": "10.0.10",
		"pdfkit": "0.20.2",
		"pino": "10.3.1",
		"qrcode": "1.5.4",
		"resend": "6.28.1",
		"sharp": "0.35.4",
		"svelte-sonner": "1.2.3",
		"sveltekit-superforms": "2.30.2",
		"swissqrbill": "4.4.1",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"tw-animate-css": "1.4.0",
		"web-push": "3.6.7",
		"zod": "4.6.5"
	}
}
